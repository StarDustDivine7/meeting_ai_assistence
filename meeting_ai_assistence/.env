# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Meeting AI Assistance"

# Database
#DATABASE_URL=sqlite:///./meeting_ai.db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_ai
# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600

# Faster-Whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Embeddings & Vector Store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
VECTOR_STORE_DIR=vector_store/data
FAISS_INDEX_TYPE=IndexFlatIP

# Grok LLM / xAI Configuration
# Set your xAI API key here (either GROK_API_KEY or XAI_API_KEY):
GROK_API_KEY=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
GROQ_API_KEY=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
XAI_API_KEY=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
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GROK_TEMPERATURE=0.2
GROK_MAX_TOKENS=800
GROK_TIMEOUT=60.0
